<odoo>
    <record id="view_hostel_student_tree" model="ir.ui.view">
        <field name="name">hostel.student.tree</field>
        <field name="model">hostel.student</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="student_id"/>
                <field name="course"/>
                <field name="contact_no"/>
                <field name="email"/>
            </list>
        </field>
    </record>

    <record id="view_hostel_student_form" model="ir.ui.view">
        <field name="name">hostel.student.form</field>
        <field name="model">hostel.student</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="student_id"/>
                        <field name="course"/>
                        <field name="contact_no"/>
                        <field name="email"/>
                        <field name="allocation_ids"/>
                    </group>
                </sheet>
                <chatter reload_on_post="True"/>
            </form>
        </field>
    </record>
    <record id="action_hostel_student" model="ir.actions.act_window">
        <field name="name">Hostel Students</field>
        <field name="res_model">hostel.student</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>
                Manage hostel students.
            </p>
        </field>
    </record>


    <odoo>
        <menuitem id="hostel_management_menu" name="Hostel Management" sequence="10"/>

        <menuitem id="menu_hostel_students" name="Students" parent="hostel_management_menu"
                  action="action_hostel_student"/>
        <menuitem id="menu_hostel_rooms" name="Rooms" parent="hostel_management_menu" action="action_hostel_room"/>
        <menuitem id="menu_hostel_allocations" name="Allocations" parent="hostel_management_menu"
                  action="action_hostel_allocation"/>
        <menuitem id="menu_hostel_fees" name="Fees" parent="hostel_management_menu" action="action_hostel_fee"/>
    </odoo>


</odoo>
