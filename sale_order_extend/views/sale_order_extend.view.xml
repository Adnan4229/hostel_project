<odoo>
    <data>
        <record id="sale_order_extend_form" model="ir.ui.view">
            <field name="name">sale.order.custom.form</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <header>
                    <button class="btn btn-secondary" string="Test" action="test"/>
                </header>
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="custom_b"/>
                    <field name="customer_order_count"/>
                </xpath>
                <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="after">
                    <field name="ab" widget="image" options="{'size': [60, 60]}" readonly="1"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
